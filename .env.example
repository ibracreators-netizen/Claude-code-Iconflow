# ── Supabase ───────────────────────────────────────────────────────────────
# Projet Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé service (serveur uniquement, jamais exposée au navigateur). Utilisée pour
# les invitations clients et les tâches d'administration.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App ────────────────────────────────────────────────────────────────────
# URL publique de l'app (redirections magic-link / OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Email(s) autorisés comme super-admin au premier login (séparés par des virgules)
ICONFLOW_ADMIN_EMAILS=ibracreators@gmail.com
