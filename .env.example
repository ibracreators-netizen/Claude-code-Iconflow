# ── Supabase ───────────────────────────────────────────────────────────────
# Projet Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé service (serveur uniquement, jamais exposée au navigateur). Utilisée pour
# les invitations clients et les tâches d'administration.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App ────────────────────────────────────────────────────────────────────
# URL publique de l'app (redirections magic-link / OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Administrateurs de départ : pas une variable d'environnement, mais la ligne `admin_emails`
# de la table `app_settings` (migration 0002). Ensuite, tout se gère dans Équipe & accès.

# ── Brain : import depuis le site de la marque (facultatif) ──────────────────
# Sans clé, l'import lit le site et en extrait les éléments (lecture simple, annoncée dans l'interface).
# Avec une clé Anthropic, les fiches sont structurées plus finement par Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # mandataire d'entreprise ou tests
# BRAIN_IMPORT_ALLOW_LOCAL=1                      # DEV/TESTS UNIQUEMENT : autorise l'import depuis une adresse locale/privée. JAMAIS en production.

# ── Meta Ads : connexion officielle + synchronisation (facultatif) ───────────
# App Meta (developers.facebook.com) > Facebook Login for Business + Marketing API.
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URL=https://ton-domaine/api/integrations/meta/callback   # défaut : NEXT_PUBLIC_APP_URL + /api/integrations/meta/callback
# META_GRAPH_VERSION=v21.0
# Secret partagé pour la synchronisation planifiée (Vercel l'envoie en Bearer sur /api/integrations/meta/sync).
CRON_SECRET=

# ── Emails : invitations et liens de connexion fiables (recommandé) ──────────
# Sans Resend, Supabase envoie les emails (service par défaut très limité : ~2/h, membres du projet seulement).
# Avec Resend + un domaine vérifié, le studio envoie ses propres emails (invitations, accès client, liens magiques).
RESEND_API_KEY=
EMAIL_FROM=Iconflow Studio <studio@icon-flow.fr>
