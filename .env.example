# ── Supabase ───────────────────────────────────────────────────────────────
# Projet Supabase > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
# Clé service (serveur uniquement, jamais exposée au navigateur). Utilisée pour
# les invitations clients et les tâches d'administration.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ── App ────────────────────────────────────────────────────────────────────
# URL publique de l'app (redirections magic-link / OAuth)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Administrateurs de départ : pas une variable d'environnement, mais la ligne `admin_emails`
# de la table `app_settings` (migration 0002). Ensuite, tout se gère dans Équipe & accès.

# ── Brain : import depuis le site de la marque (facultatif) ──────────────────
# Sans clé, l'import lit le site et en extrait les éléments (lecture simple, annoncée dans l'interface).
# Avec une clé Anthropic, les fiches sont structurées plus finement par Claude.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com   # mandataire d'entreprise ou tests
# BRAIN_IMPORT_ALLOW_LOCAL=1                      # DEV/TESTS UNIQUEMENT : autorise l'import depuis une adresse locale/privée. JAMAIS en production.

# ── Meta Ads : connexion officielle + synchronisation (facultatif) ───────────
# App Meta (developers.facebook.com) > Facebook Login for Business + Marketing API.
META_APP_ID=
META_APP_SECRET=
# META_REDIRECT_URL=https://ton-domaine/api/integrations/meta/callback   # défaut : NEXT_PUBLIC_APP_URL + /api/integrations/meta/callback
# META_GRAPH_VERSION=v21.0
# Secret partagé des tâches planifiées (Bearer) : synchro Meta et planificateur Marketing (/api/marketing/cron).
CRON_SECRET=

# ── Emails : invitations et liens de connexion fiables (recommandé) ──────────
# Sans Resend, Supabase envoie les emails (service par défaut très limité : ~2/h, membres du projet seulement).
# Avec Resend + un domaine vérifié, le studio envoie ses propres emails (invitations, accès client, liens magiques).
RESEND_API_KEY=
EMAIL_FROM=Iconflow Studio <studio@icon-flow.fr>

# ── IconFlow Marketing (facultatif) ──────────────────────────────────────────
# Secret du webhook d'opt-in (POST /api/marketing/optin). Sans lui, l'endpoint répond « non configuré ».
MARKETING_OPTIN_SECRET=
# Ancienne route, gardée en secours. Les sites écrivent désormais dans la base (fonction lead_inbox_receive).
# Réception des leads : le planificateur Supabase appelle /api/marketing/cron avec CRON_SECRET ci-dessus
# (même valeur à ranger dans le coffre Supabase, voir supabase/ops/marketing_planificateur.sql).
# Les alertes « nouveau lead » et « erreur » partent par RESEND_API_KEY + EMAIL_FROM ci-dessus ; sans elles,
# elles sont simulées et l'app l'affiche. SUPABASE_SERVICE_ROLE_KEY est nécessaire au traitement des leads.
# Les emails aux prospects restent en DRY RUN tant que « Envoi réel » n'est pas activé dans les réglages Marketing.

# Outil de réservation (iClosed) : clé d'accès à l'API (iClosed > Settings > Developer > API Keys).
ICLOSED_API_KEY=
# Facultatif : active les notifications immédiates d'iClosed. Longue valeur aléatoire, à mettre aussi dans
# l'adresse donnée à iClosed (/api/marketing/sources/webhook?cle=...). Sans elle, la route reste éteinte.
ICLOSED_WEBHOOK_SECRET=

# Google Agenda (lecture seule) : identifiants OAuth « Application Web » (console.cloud.google.com > Identifiants).
# Marche à suivre complète : docs/features/marketing.md, « Mise en place dans Google Cloud ».
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URL=https://ton-domaine/api/marketing/google/callback   # défaut : NEXT_PUBLIC_APP_URL + ce chemin
# Chiffre les jetons Google stockés. Longue valeur aléatoire (32 caractères au moins). Ne plus la changer ensuite.
MARKETING_ENCRYPTION_KEY=
